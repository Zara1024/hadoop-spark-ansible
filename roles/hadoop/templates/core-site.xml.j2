<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- core-site.xml: 生成自 Ansible 自动化部署模板 (严格对齐 PDF 第 12 页) -->
<configuration>
    <!-- 用来指定 hdfs 的老大，ns 为固定属性名，对应两个 namenode -->
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://{{ hadoop_nameservice }}</value>
    </property>

    <!-- 用来指定 hadoop 运行时产生文件的存放目录 -->
    <property>
        <name>hadoop.tmp.dir</name>
        <value>{{ hadoop_tmp_dir }}</value>
    </property>

    <!-- ZooKeeper 集群地址 -->
    <property>
        <name>ha.zookeeper.quorum</name>
        <value>{% for host in groups['zookeepers'] %}{{ host }}:{{ zk_client_port }}{% if not loop.last %},{% endif %}{% endfor %}</value>
    </property>
</configuration>
