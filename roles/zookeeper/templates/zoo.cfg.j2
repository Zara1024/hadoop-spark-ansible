# The number of milliseconds of each tick
tickTime=2000
# The number of ticks that the initial synchronization phase can take
initLimit=10
# The number of ticks that can pass between sending a request and getting an acknowledgement
syncLimit=5

# The directory where the snapshot is stored. (PDF 第 8 页)
dataDir={{ zk_data_dir }}
dataLogDir={{ zk_log_dir }}

# The port at which the clients will connect
clientPort={{ zk_client_port }}

# 集群成员定义 (严格对齐 PDF 第 8 页)
{% for host in groups['zookeepers'] %}
server.{{ hostvars[host]['myid'] }}={{ host }}:{{ zk_peer_port }}:{{ zk_election_port }}
{% endfor %}

# 避免 zkfc 报 using SASL (unknown error) (PDF 第 22 页特别注明)
zookeeper.sasl.client={{ zk_sasl_client }}
